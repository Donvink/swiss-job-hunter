# ── LLM providers ──────────────────────────────────────────────────────────────
# At least one key is required. All three can coexist for round-robin rotation.
ANTHROPIC_API_KEY=sk-ant-
DEEPSEEK_API_KEY=sk-
OPENROUTER_API_KEY=sk-or-

# auto=round-robin | anthropic | deepseek | openrouter
LLM_PROVIDER=auto

ANTHROPIC_MODEL=claude-sonnet-4-20250514
DEEPSEEK_MODEL=deepseek-chat
# Any model slug from https://openrouter.ai/models
OPENROUTER_MODEL=openai/gpt-4o-mini

# Local Ollama (no API key required).
# When running via Docker, use host.docker.internal instead of localhost:
# OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
# When running without Docker:
# OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_BASE_URL=
OLLAMA_MODEL=
OLLAMA_THINK=False

# ── Database ────────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./data/jobs.db

# ── Search defaults ─────────────────────────────────────────────────────────────
DEFAULT_KEYWORD=Agent
DEFAULT_LOCATION=Zürich
DEFAULT_LANGUAGE=en
SEARCH_RADIUS_KM=30
KEYWORD_PRESETS={"devops": ["DevOps engineer", "SRE", "platform engineer", "infrastructure engineer"], "backend": ["backend engineer", "Go engineer", "Python engineer"]}

# ── Scoring ─────────────────────────────────────────────────────────────────────
# Sentence describing the candidate's profile, fed to the LLM scoring prompt.
# Optional. One sentence describing the candidate, prepended to the LLM scoring
# system prompt. The CV already describes the candidate, so leave it empty unless
# you want to steer the model (e.g. toward a career change the CV does not show).
CANDIDATE_PERSONA=

# ── Dedup ───────────────────────────────────────────────────────────────────────
SEMANTIC_SIMILARITY_THRESHOLD=0.92
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── Scraper ─────────────────────────────────────────────────────────────────────
SCRAPER_DELAY_MIN=1.5
SCRAPER_DELAY_MAX=4.0
SCRAPER_MAX_PAGES=10
PLAYWRIGHT_HEADLESS=true

# ── LinkedIn (optional) ──────────────────────────────────────────────────────────
# Paste the `li_at` cookie value from your browser to enable authenticated search.
# How to get it: open linkedin.com → F12 → Application → Cookies → li_at → copy Value
# Without this, LinkedIn search is capped at ~40 results (guest mode).
LINKEDIN_COOKIE=
# Optional proxy for LinkedIn scraping. Switch this if your IP gets blocked.
# Formats: http://host:port  |  http://user:pass@host:port  |  socks5://host:port
LINKEDIN_PROXY=

# ── Email application ───────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@email.com
SMTP_PASSWORD=your-app-password
APPLY_FROM_EMAIL=your@email.com
APPLY_FROM_NAME=Your Name

# ── Scheduler ───────────────────────────────────────────────────────────────────
SCHEDULE_ENABLED=false
SCHEDULE_CRON=0 8 * * 1-5

# ── CV path ─────────────────────────────────────────────────────────────────────
CV_PDF_PATH=./data/cv.pdf
CV_TEXT_PATH=./data/cv.txt

# Direction used when the UI runs with "ALL" selected. Jobs scraped that way get
# labelled with it and are scored against ./data/cv_<direction>.txt. Leave empty
# if you keep a single CV — jobs then stay unlabelled and score against
# CV_TEXT_PATH, which is the previous behaviour.
DEFAULT_DIRECTION=

# ── Docker / frontend ─────────────────────────────────────────────────────────
# Base URL the browser uses to reach the backend API. Inlined into the frontend
# bundle at build time. Defaults to http://localhost:8765 (local compose). For a
# remote deploy, set this to the public backend address, e.g.
# VITE_API_BASE_URL=https://jobs.example.com:8765
# VITE_API_BASE_URL=http://localhost:8765
# VITE_API_BASE_URL=http://tailscale-ip:8765
